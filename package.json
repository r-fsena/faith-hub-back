{
  "name": "faith-hub-backend",
  "version": "1.0.0",
  "description": "Serverless AWS Backend for Faith Hub Ecosystem",
  "main": "handler.js",
  "scripts": {
    "start": "export $(grep -v '^#' .env | xargs) && serverless offline start",
    "deploy": "npm run typecheck && npm test && node deploy_aws.js",
    "deploy:ops:live": "node deploy_aws.js deploy --config serverless-ops.yml --stage live",
    "package:prod": "serverless package --stage prod --package .serverless-prod",
    "ops:audit:rds": "node scripts/audit-rds-resilience.cjs",
    "ops:enforce:rds": "node scripts/enforce-rds-resilience.cjs --apply",
    "ops:audit:s3": "node scripts/audit-s3-resilience.cjs",
    "ops:enforce:s3": "node scripts/enforce-s3-resilience.cjs --apply",
    "db:migrate": "node migrate_all.js",
    "db:migrate:asaas": "node migrate_asaas_billing.js",
    "db:migrate:asaas:status": "node migrate_asaas_billing.js --status",
    "db:migrate:asaas:checkout-correlation": "node migrate_asaas_checkout_correlation.js",
    "db:migrate:secretariat": "node migrate_secretariat_foundation.js",
    "db:migrate:secretariat:status": "node migrate_secretariat_foundation.js --status",
    "db:migrate:secretariat:phase2": "node migrate_secretariat_phase2.js",
    "db:migrate:secretariat:phase2:status": "node migrate_secretariat_phase2.js --status",
    "db:migrate:secretariat:template-ids": "node migrate_secretariat_template_ids.js",
    "db:migrate:secretariat:template-ids:status": "node migrate_secretariat_template_ids.js --status",
    "db:migrate:secretariat:template-studio": "node migrate_secretariat_template_studio.js",
    "db:migrate:secretariat:template-studio:status": "node migrate_secretariat_template_studio.js --status",
    "db:migrate:secretariat:template-studio-flags": "node migrate_secretariat_template_studio_flags.js",
    "db:migrate:secretariat:template-studio-flags:status": "node migrate_secretariat_template_studio_flags.js --status",
    "db:migrate:studio-experience": "node migrate_studio_experience.js",
    "db:migrate:studio-experience:status": "node migrate_studio_experience.js --status",
    "db:migrate:studio-navigation-v2": "node migrate_studio_navigation_v2.js",
    "db:migrate:studio-navigation-v2:status": "node migrate_studio_navigation_v2.js --status",
    "db:migrate:studio-v2-default-tenant": "node migrate_studio_v2_default_tenant.js",
    "db:migrate:studio-v2-default-tenant:status": "node migrate_studio_v2_default_tenant.js --status",
    "db:migrate:pdv-inventory": "node migrate_pdv_inventory.js",
    "db:migrate:pdv-inventory:status": "node migrate_pdv_inventory.js --status",
    "db:migrate:pdv-inventory:flags": "node migrate_pdv_inventory_flag_fix.js",
    "db:migrate:pdv-inventory:flags:status": "node migrate_pdv_inventory_flag_fix.js --status",
    "db:migrate:pdv-product-availability": "node migrate_pdv_product_availability.js",
    "db:migrate:pdv-product-availability:status": "node migrate_pdv_product_availability.js --status",
    "db:migrate:pdv-sales-analytics": "node migrate_pdv_sales_analytics.js",
    "db:migrate:pdv-sales-analytics:status": "node migrate_pdv_sales_analytics.js --status",
    "secrets:sync:asaas": "node scripts/sync-asaas-secret.cjs",
    "webhook:sync:asaas": "node scripts/sync-asaas-webhook.cjs",
    "billing:pilot:asaas": "node scripts/set-asaas-production-pilot.cjs",
    "db:migrate:status": "node migrate_all.js --status",
    "db:sync": "npx ts-node src/db/syncCognito.ts",
    "test": "node --test tests/*.test.cjs",
    "db:migrate:security": "node migrate_security_tenants.js",
    "typecheck": "tsc --noEmit",
    "db:migrate:commercial-plans": "node migrate_commercial_plans.js",
    "db:migrate:commercial-plans:status": "node migrate_commercial_plans.js --status",
    "db:migrate:commercial-plans:check": "node migrate_commercial_plans.js --check",
    "db:migrate:commercial-plans:schema": "node migrate_commercial_plans.js --schema-only",
    "db:migrate:public-journey": "node migrate_public_journey.js",
    "db:migrate:public-journey:status": "node migrate_public_journey.js --status",
    "db:migrate:pwa-experience": "node migrate_pwa_experience.js",
    "db:migrate:pwa-experience:status": "node migrate_pwa_experience.js --status",
    "db:migrate:intelligence": "node migrate_intelligence.js",
    "db:migrate:intelligence:status": "node migrate_intelligence.js --status",
    "db:migrate:intelligence:schema": "node migrate_intelligence.js --schema-only",
    "test:intelligence:mysql": "node scripts/test-intelligence-mysql.cjs --temporary-only",
    "db:migrate:intelligence:journeys": "node migrate_intelligence_journeys.js",
    "db:migrate:intelligence:journeys:status": "node migrate_intelligence_journeys.js --status",
    "db:migrate:intelligence:journeys:schema": "node migrate_intelligence_journeys.js --schema-only",
    "db:migrate:intelligence:operations": "node migrate_intelligence_operations.js",
    "db:migrate:intelligence:operations:status": "node migrate_intelligence_operations.js --status",
    "db:migrate:intelligence:foundations": "node migrate_intelligence_foundations.js",
    "db:migrate:intelligence:foundations:status": "node migrate_intelligence_foundations.js --status",
    "test:intelligence:foundations:mysql": "node scripts/test-intelligence-foundations-mysql.cjs --isolated-schema"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1166.0",
    "@aws-sdk/client-dynamodb": "^3.1156.0",
    "@aws-sdk/client-s3": "^3.1020.0",
    "@aws-sdk/client-secrets-manager": "^3.1156.0",
    "@aws-sdk/client-sqs": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1020.0",
    "@aws-sdk/util-dynamodb": "^3.996.9",
    "aws-ssl-profiles": "^1.1.2",
    "cors": "^2.8.5",
    "jose": "^5.10.0",
    "mysql2": "^3.24.6",
    "uuid": "^11.1.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@aws-sdk/client-amplify": "^3.1111.0",
    "@aws-sdk/client-rds": "^3.1157.0",
    "@aws-sdk/client-route-53": "^3.1111.0",
    "@types/aws-lambda": "^8.10.119",
    "@types/node": "^20.0.0",
    "@types/node-fetch": "^2.6.13",
    "@types/uuid": "^10.0.0",
    "esbuild": "^0.19.0",
    "serverless": "^3.38.0",
    "serverless-esbuild": "^1.46.0",
    "serverless-offline": "^13.0.0",
    "serverless-plugin-split-stacks": "^1.15.0",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "axios": "1.21.1"
  }
}
