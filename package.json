{
  "name": "faith-hub-backend",
  "version": "1.0.0",
  "description": "Serverless AWS Backend for Faith Hub Ecosystem",
  "main": "handler.js",
  "scripts": {
    "start": "export $(grep -v '^#' .env | xargs) && serverless offline start",
    "deploy": "npm run typecheck && npm test && node deploy_aws.js",
    "db:migrate": "node migrate_all.js",
    "db:migrate:status": "node migrate_all.js --status",
    "db:sync": "npx ts-node src/db/syncCognito.ts",
    "test": "node --test tests/*.test.cjs",
    "db:migrate:security": "node migrate_security_tenants.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.0.0",
    "@aws-sdk/client-dynamodb": "^3.1156.0",
    "@aws-sdk/client-s3": "^3.1020.0",
    "@aws-sdk/client-secrets-manager": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1020.0",
    "@aws-sdk/util-dynamodb": "^3.996.9",
    "aws-ssl-profiles": "^1.1.2",
    "cors": "^2.8.5",
    "jose": "^5.10.0",
    "mysql2": "^3.9.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@aws-sdk/client-amplify": "^3.1111.0",
    "@aws-sdk/client-route-53": "^3.1111.0",
    "@types/aws-lambda": "^8.10.119",
    "@types/node": "^20.0.0",
    "@types/node-fetch": "^2.6.13",
    "@types/uuid": "^10.0.0",
    "esbuild": "^0.19.0",
    "serverless": "^3.38.0",
    "serverless-esbuild": "^1.46.0",
    "serverless-offline": "^13.0.0",
    "serverless-plugin-split-stacks": "^1.15.0",
    "typescript": "^5.0.0"
  }
}
